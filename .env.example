# Modelos con formato "proveedor:modelo" (langchain init_chat_model).
# El principal corre el agente de datos y la respuesta final; el rápido, el router y el agente de documentos.

# --- Anthropic ---
LLM_MODEL=anthropic:claude-sonnet-5-5
LLM_MODEL_RAPIDO=anthropic:claude-haiku-5-5
# ANTHROPIC_API_KEY=...

# --- OpenAI ---
# LLM_MODEL=openai:gpt-4.1
# LLM_MODEL_RAPIDO=openai:gpt-4.1-mini
# OPENAI_API_KEY=...

# --- Azure OpenAI (el modelo es el nombre del deployment) ---
# LLM_MODEL=azure_openai:mi-deployment-grande
# LLM_MODEL_RAPIDO=azure_openai:mi-deployment-chico
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
# OPENAI_API_VERSION=2024-10-21

# Guardrails
MAX_PASOS_AGENTE=12      # recursion_limit de cada agente ReAct
MAX_FILAS=100            # filas máximas que devuelve ejecutar_sql
UMBRAL_CONFIANZA=80      # debajo de esto, la definición viene con advertencia
TOP_K_DOCUMENTOS=3

# Trazas (opcional): LangSmith se activa solo con estas variables
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
